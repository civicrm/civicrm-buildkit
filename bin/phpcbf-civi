#!/usr/bin/env bash

###############################################################################
## Bootstrap

## Determine the absolute path of the directory with the file
## usage: absdirname <file-path>
function absdirname() {
  pushd $(dirname $0) >> /dev/null
    pwd
  popd >> /dev/null
}

BINDIR=$(absdirname "$0")
PRJDIR=$(dirname "$BINDIR")
PHPCS_STD="$PRJDIR/app/phpcs/CiviCRM"

###############################################################################
## Function library

eval "$BINDIR/phpcbf" --standard="$PHPCS_STD" "$@"
