#!/usr/bin/env bash

###############################################################################
## Bootstrap

## The tools/civilint/ folder. Resolved from this script's real path, because
## it is usually run through a symlink (e.g. buildkit's bin/phpcbf-civi).
CIVILINT_DIR=$(XDEBUG_MODE=off php -r 'echo dirname(realpath($argv[1]), 2);' -- "$0")
PHPCS_STD="$CIVILINT_DIR/phpcs/CiviCRM"

###############################################################################
## Function library

eval "$CIVILINT_DIR/bin/phpcbf" --standard="$PHPCS_STD" "$@"
