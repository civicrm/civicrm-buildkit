#!/usr/bin/env bash

###############################################################################
## Bootstrap

## Determine the absolute path of the directory with the file
## usage: absdirname <file-path>
function absdirname() {
  pushd $(dirname $0) >> /dev/null
    pwd
  popd >> /dev/null
}

BINDIR=$(absdirname "$0")
PRJDIR=$(dirname "$BINDIR")
PHPCS_STD="$PRJDIR/tools/civilint/phpcs/CiviCRM"
## FIXME: Finish removing PRJDIR references. Everything here should be contained to PRJDIR/tools/civilint/.

###############################################################################
## Function library

eval "$BINDIR/phpcs" --standard="$PHPCS_STD" "$@"
